# Local development: Node.js 24+, persistent SQLite and photos in .data/
STUDY_STORAGE=local
# Generated by npm run setup:members; never use real passwords in source files.
STUDY_PASSWORD_HASHES=
# Production: set STUDY_STORAGE=supabase and the following server-only values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used for hashing login attempt identifiers. Generate a random value for production.
LOGIN_HASH_SECRET=
